<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.VIBRATE" />
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_keyboard"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <provider android:name=".clipboard.ClipboardImageProvider" android:authorities="${applicationId}.clips"
            android:exported="false" android:grantUriPermissions="true" />
        <activity android:name=".settings.SettingsActivity" android:exported="true" android:theme="@style/SettingsTheme"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".settings.LayoutSettingsActivity" android:exported="false"
            android:enableOnBackInvokedCallback="true" android:theme="@style/SettingsTheme" />
        <activity android:name=".settings.OptionsSettingsActivity" android:exported="false" android:theme="@style/SettingsTheme" />
        <activity android:name=".settings.CharacterSettingsActivity" android:exported="false"
            android:theme="@style/SettingsTheme" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".settings.InputPracticeActivity" android:exported="false"
            android:label="@string/section_test" android:theme="@style/SettingsTheme" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".settings.TouchLearningActivity" android:exported="false"
            android:theme="@style/SettingsTheme" android:windowSoftInputMode="adjustResize" />
        <service
            android:name=".ime.MinjjImeService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/input_method" />
        </service>
    </application>
</manifest>
